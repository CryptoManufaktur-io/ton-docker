# The settings are in .env, use "nano .env". Don't edit default.env itself.
COMPOSE_FILE=ton.yml

# Further variables such as RPC, WS ports, P2P ports, NETWORk, SNAPSHOT, LOG_LEVEL, &c

# Tag of the upstream ghcr.io/ton-blockchain/ton image that the validator binaries are copied from at build time.
# "latest" follows upstream. To pin, use an architecture suffixed release tag such as vYYYY.MM-amd64, then run
# ./tond update and ./tond up. This does not select the network, see NETWORK below.
TON_BRANCH=latest
# consider switching global config to testnet https://ton.org/testnet-global.config.json, if you set NETWORK=testnet
#GLOBAL_CONFIG_URL=https://ton.org/testnet-global.config.json
GLOBAL_CONFIG_URL=https://ton.org/global.config.json
MYTONCTRL_VERSION=master
# Optional: mytonctrl release tag (e.g. v2.19.0) to apply on every start if not already applied. MYTONCTRL_VERSION only
# matters on the first install. Leave empty to keep whatever is installed.
MYTONCTRL_TAG=
TELEMETRY=true
IGNORE_MINIMAL_REQS=true
MODE=liteserver
DUMP=true
ARCHIVE_TTL=2592000
STATE_TTL=2592000
SYNC_BEFORE=2592000
VERBOSITY=2
CUSTOM_PARAMETERS=
PUBLIC_IP=
VALIDATOR_PORT=30001
# QUIC (node v2026.10+) listens on VALIDATOR_PORT + 1000
QUIC_PORT=31001
LITESERVER_PORT=30003
VALIDATOR_CONSOLE_PORT=30002

# Prometheus metrics: validator-engine serves /metrics on its own port (container-internal, not published).
# Set METRICS_ENABLE=false to turn it off (the scrape label follows it).
METRICS_ENABLE=true
METRICS_PORT=9102
# mainnet or testnet. Selects the network on first install (mytonctrl install -n) and is the "network" label on scraped metrics.
# For testnet also set GLOBAL_CONFIG_URL to the testnet global config.
NETWORK=mainnet

# For ton api
TON_API_HTTP_PORT=8081
TON_API_LOGS_LEVEL=INFO
TON_API_GET_METHODS_ENABLED=1
TON_API_JSON_RPC_ENABLED=1
TON_API_WEBSERVERS_WORKERS=1
TON_API_CACHE_ENABLED=0
TON_API_ROOT_PATH=/
TON_API_TONLIB_PARALLEL_REQUESTS_PER_LITESERVER=50
TON_API_TONLIB_REQUEST_TIMEOUT=10
TON_API_LOGS_JSONIFY=0
TON_API_GUNICORN_FLAGS=

# Secure web proxy - advanced use, please see instructions
DOMAIN=example.com
RPC_HOST=ton
RPC_LB=ton-lb

# IP of the host you want to use in Docker (in case host has several IPs)
HOST_IP=
# IP address to use when host-mapping a port through *-shared.yml. Set this to 127.0.0.1 to restrict the share to localhost
SHARE_IP=

# External Docker network if using ext-network.yml
DOCKER_EXT_NETWORK=traefik_default

# Set a Github tag here to pin the script to a version.
SCRIPT_TAG=

# Used by script update - please do not adjust
ENV_VERSION=2
